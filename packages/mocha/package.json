{
  "name": "@spikedpunch/cbd-mocha",
  "version": "0.0.4",
  "type": "module",
  "description": "Mocha adapter: turns a plain mocha run into per-test coverage windows.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./auto": "./dist/src/auto.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node bin/test.js",
    "prepack": "node ../../scripts/sync-changelogs.mjs"
  },
  "dependencies": {
    "@spikedpunch/cbd": "workspace:*"
  },
  "devDependencies": {
    "@japa/runner": "^5.4.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "mocha": "^10.8.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/src",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpikedPunchVictim/cbd.git",
    "directory": "packages/mocha"
  }
}
