{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    // @types/mocha is a CommonJS `export =`, so the default import needs interop
    // to type-check. Local to this package: the adapter is the only place in the
    // workspace that consumes a CJS-typed dependency.
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
