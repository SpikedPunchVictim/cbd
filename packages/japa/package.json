{
  "name": "@spikedpunch/cbd-japa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "japa adapter: turns a plain japa run into per-test coverage windows, and selects with them.",
  "main": "./dist/src/index.js",
